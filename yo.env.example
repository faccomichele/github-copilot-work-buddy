# Copy to yo.env (ignored by git). Everything is optional except where the defaults do not fit.

# Optional project number to pin one project. If omitted, use all active projects for YO_OWNER.
#YO_PROJECT=1

# Folder that contains your local clones, searched up to 6 levels deep (default: parent of this repo)
#YO_REPOS_ROOT=$HOME/code

# Tracking repo and project owner (default: this repo's origin)
#YO_REPO=owner/to-do
#YO_OWNER=owner

# Owner for short repo:<name> labels (default: tracking repo owner; independent of Project owner)
# Set to faccomichele to keep short labels targeting upstream repos
#YO_REPO_OWNER=faccomichele

# Branch prefix for implementation branches (default: your GitHub login, lowercase, without any _suffix)
#YO_BRANCH_PREFIX=jdoe
